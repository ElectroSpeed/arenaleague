<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Saisie des résultats — écran principal de l'Arbitre.

  La liste à gauche, le détail du match sélectionné à droite. Les actions
  proposées dépendent de l'état du match, mais l'écran ne décide jamais
  d'un refus : il appelle le service, et la machine à états accepte ou
  refuse. C'est ce qui permet de démontrer CE-02 sans code spécial.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.lahorde.arenaleague.controller.SaisieResultatsController"
            styleClass="contenu-page"
            prefWidth="1080"
            prefHeight="700">

    <top>
        <HBox styleClass="barre-superieure" alignment="CENTER_LEFT" spacing="10">
            <Label text="ARENA" styleClass="marque"/>
            <Label text="LEAGUE" styleClass="marque, marque-accent">
                <HBox.margin><Insets left="-4"/></HBox.margin>
            </Label>
            <Label text="/" styleClass="separateur-fil">
                <HBox.margin><Insets left="6" right="6"/></HBox.margin>
            </Label>
            <Label fx:id="nomTournoi"/>
            <Label fx:id="formatTournoi" styleClass="badge-etat, badge-ouvert"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="nomUtilisateur"/>
            <Label fx:id="badgeRole" styleClass="badge-role"/>
            <Button text="Retour" onAction="#retourAccueil" styleClass="bouton-secondaire"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="24" right="20" bottom="24" left="28"/></padding>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <VBox spacing="4">
                    <Label text="Matchs" styleClass="titre-section"/>
                    <Region styleClass="filet-accent" prefHeight="3" maxWidth="56" minHeight="3"/>
                </VBox>

                <Label fx:id="resumeMatchs" styleClass="aide-champ" wrapText="true"/>

                <TableView fx:id="tableMatchs" VBox.vgrow="ALWAYS" prefHeight="240">
                    <columns>
                        <TableColumn fx:id="colonneTour"    text="TOUR"     prefWidth="80"/>
                        <TableColumn fx:id="colonneEquipeA" text="ÉQUIPE A" prefWidth="140"/>
                        <TableColumn fx:id="colonneScore"   text="SCORE"    prefWidth="80"/>
                        <TableColumn fx:id="colonneEquipeB" text="ÉQUIPE B" prefWidth="140"/>
                        <TableColumn fx:id="colonneEtat"    text="ÉTAT"     prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!--
              Le classement vit sur le même écran que la saisie, et non
              derrière une navigation : c'est ce qui rend le rafraîchissement
              visible au moment même où le score est validé. L'étape 4 du
              scénario demande que « le classement se réordonne
              immédiatement » — encore faut-il l'avoir sous les yeux.
            -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <VBox spacing="4">
                    <Label text="Classement" styleClass="titre-section"/>
                    <Region styleClass="filet-accent" prefHeight="3" maxWidth="56" minHeight="3"/>
                </VBox>

                <Label fx:id="noteClassement" styleClass="aide-champ" wrapText="true"/>

                <TableView fx:id="tableClassement" VBox.vgrow="ALWAYS" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colonneRang"      text="#"      prefWidth="46"/>
                        <TableColumn fx:id="colonneEquipe"    text="ÉQUIPE" prefWidth="140"/>
                        <TableColumn fx:id="colonnePoints"    text="PTS"    prefWidth="52"/>
                        <TableColumn fx:id="colonneJoues"     text="J"      prefWidth="40"/>
                        <TableColumn fx:id="colonneVictoires" text="V"      prefWidth="40"/>
                        <TableColumn fx:id="colonneNuls"      text="N"      prefWidth="40"/>
                        <TableColumn fx:id="colonneDefaites"  text="D"      prefWidth="40"/>
                        <TableColumn fx:id="colonneMarques"   text="BM"     prefWidth="46"/>
                        <TableColumn fx:id="colonneEncaisses" text="BE"     prefWidth="46"/>
                        <TableColumn fx:id="colonneDifference" text="DIFF"  prefWidth="54"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox styleClass="panneau-droit" spacing="14" prefWidth="380">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <Label text="Match sélectionné" styleClass="titre-section"/>

            <Label fx:id="zoneAucuneSelection"
                   styleClass="zone-vide"
                   wrapText="true"
                   maxWidth="Infinity"
                   text="Choisissez un match dans la liste pour le démarrer ou en saisir le score."/>

            <VBox fx:id="detailMatch"
                  spacing="14"
                  visible="false"
                  managed="false">

                <Label fx:id="affiche" styleClass="affiche-match" wrapText="true"/>
                <Label fx:id="etatMatch" styleClass="aide-champ" wrapText="true"/>

                <!-- Avertissement affiché pour un match clôturé (RG-53). La
                     saisie reste tentable : c'est le cas de démonstration
                     CE-02, imposé par le sujet. -->
                <Label fx:id="avertissementCloture"
                       styleClass="message-info"
                       wrapText="true"
                       maxWidth="Infinity"
                       visible="false"
                       managed="false"/>

                <VBox fx:id="zoneScore" spacing="8">
                    <Label text="SCORE" styleClass="etiquette-champ"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label fx:id="etiquetteEquipeA" styleClass="aide-champ"/>
                            <TextField fx:id="champScoreA" prefWidth="72" alignment="CENTER"/>
                        </VBox>
                        <Label text="–" styleClass="separateur-score"/>
                        <VBox spacing="4">
                            <Label fx:id="etiquetteEquipeB" styleClass="aide-champ"/>
                            <TextField fx:id="champScoreB" prefWidth="72" alignment="CENTER"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="regleScore" styleClass="aide-champ" wrapText="true"/>
                </VBox>

                <Label fx:id="messageErreur"
                       styleClass="message-erreur"
                       wrapText="true"
                       maxWidth="Infinity"
                       visible="false"
                       managed="false"/>

                <Label fx:id="messageSucces"
                       styleClass="message-succes"
                       wrapText="true"
                       maxWidth="Infinity"
                       visible="false"
                       managed="false"/>

                <Button fx:id="boutonDemarrer"
                        text="Démarrer le match"
                        onAction="#demarrerMatch"
                        styleClass="bouton-principal"
                        maxWidth="Infinity"
                        prefHeight="40"
                        visible="false"
                        managed="false"/>

                <Button fx:id="boutonValider"
                        text="Valider le score"
                        onAction="#validerScore"
                        styleClass="bouton-principal"
                        maxWidth="Infinity"
                        prefHeight="40"
                        visible="false"
                        managed="false"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
