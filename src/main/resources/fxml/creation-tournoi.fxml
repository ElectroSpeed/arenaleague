<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Création d'un tournoi — réservé à l'Organisateur.

  L'écran est découpé en deux étapes numérotées à gauche, le résultat à
  droite. Ce découpage n'est pas décoratif : il sépare ce que l'utilisateur
  saisit de ce que l'application produit, et rend visible qu'il reste une
  étape avant le calendrier.

  Le masquage du bouton d'accueil reste du confort. Le refus qui compte est
  celui de TournoiService, et il s'applique même si on force le passage.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.lahorde.arenaleague.controller.CreationTournoiController"
            styleClass="contenu-page"
            prefWidth="1080"
            prefHeight="700">

    <top>
        <HBox styleClass="barre-superieure" alignment="CENTER_LEFT" spacing="10">
            <Label text="ARENA" styleClass="marque"/>
            <Label text="LEAGUE" styleClass="marque, marque-accent">
                <HBox.margin><Insets left="-4"/></HBox.margin>
            </Label>
            <Label text="/" styleClass="separateur-fil">
                <HBox.margin><Insets left="6" right="6"/></HBox.margin>
            </Label>
            <Label text="Nouveau tournoi"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Annuler et revenir" onAction="#retourAccueil" styleClass="bouton-secondaire"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="panneau" spacing="15" prefWidth="470">
            <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

            <!-- Étape 1 : le tournoi -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="1" styleClass="numero-etape"/>
                <Label text="Le tournoi" styleClass="titre-section"/>
            </HBox>

            <VBox spacing="6">
                <Label text="NOM DU TOURNOI" styleClass="etiquette-champ"/>
                <TextField fx:id="champNom" promptText="Coupe de printemps"/>
            </VBox>

            <VBox spacing="6">
                <Label text="DATE DE DÉBUT" styleClass="etiquette-champ"/>
                <DatePicker fx:id="champDate" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="FORMAT" styleClass="etiquette-champ"/>
                <ComboBox fx:id="champFormat" maxWidth="Infinity"/>
                <!-- Texte fourni par la stratégie du format, jamais écrit ici. -->
                <Label fx:id="contrainteFormat" styleClass="aide-champ" wrapText="true"/>
            </VBox>

            <!-- Étape 2 : les équipes -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="10"/></padding>
                <Label text="2" styleClass="numero-etape"/>
                <Label text="Les équipes" styleClass="titre-section"/>
            </HBox>

            <Label fx:id="regleEffectif" styleClass="aide-champ" wrapText="true"/>

            <ListView fx:id="listeEquipes" VBox.vgrow="ALWAYS" prefHeight="180"/>

            <!-- Dit en permanence combien d'équipes sont cochées et ce qu'il
                 manque pour que le format soit satisfait. -->
            <Label fx:id="compteurEquipes"
                   styleClass="compteur"
                   wrapText="true"
                   maxWidth="Infinity"/>

            <Label fx:id="messageErreur"
                   styleClass="message-erreur"
                   wrapText="true"
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"/>

            <VBox spacing="6">
                <Button fx:id="boutonGenerer"
                        text="Créer le tournoi et générer le calendrier"
                        onAction="#creerEtGenerer"
                        defaultButton="true"
                        styleClass="bouton-principal"
                        maxWidth="Infinity"
                        prefHeight="42"/>
                <Label text="Le démarrage est définitif : une fois le calendrier généré, la composition du tournoi ne peut plus changer (RG-22)."
                       styleClass="aide-champ"
                       wrapText="true"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets top="26" right="32" bottom="26" left="32"/></padding>

            <VBox spacing="4">
                <Label text="Calendrier" styleClass="titre-section"/>
                <Region styleClass="filet-accent" prefHeight="3" maxWidth="56" minHeight="3"/>
            </VBox>

            <Label fx:id="messageSucces"
                   styleClass="message-succes"
                   wrapText="true"
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"/>

            <Label fx:id="resumeCalendrier"
                   styleClass="message-info"
                   wrapText="true"
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"/>

            <TableView fx:id="tableCalendrier" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colonneTour"    text="TOUR"     prefWidth="140"/>
                    <TableColumn fx:id="colonneEquipeA" text="ÉQUIPE A" prefWidth="210"/>
                    <TableColumn fx:id="colonneEquipeB" text="ÉQUIPE B" prefWidth="210"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="boutonTerminer"
                        text="Terminer et revenir à l'accueil"
                        onAction="#retourAccueil"
                        styleClass="bouton-principal"
                        prefHeight="38"
                        visible="false"
                        managed="false"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
