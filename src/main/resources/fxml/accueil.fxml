<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.lahorde.arenaleague.controller.AccueilController"
            styleClass="contenu-page"
            prefWidth="1080"
            prefHeight="700">

    <top>
        <HBox styleClass="barre-superieure" alignment="CENTER_LEFT" spacing="14">
            <Label text="ARENA" styleClass="marque"/>
            <Label text="LEAGUE" styleClass="marque, marque-accent">
                <HBox.margin><Insets left="-4"/></HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="nomUtilisateur"/>
            <Label fx:id="badgeRole" styleClass="badge-role"/>
            <Button text="Déconnexion" onAction="#seDeconnecter" styleClass="bouton-secondaire"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

            <VBox spacing="4">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="Tournois" styleClass="titre-section"/>
                    <Label fx:id="compteurTournois" styleClass="aide-champ"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Visible pour l'Organisateur seulement. Le refus réel
                         est dans le service : voir CE-01. -->
                    <Button fx:id="boutonCreerTournoi"
                            text="Créer un tournoi"
                            onAction="#creerTournoi"
                            styleClass="bouton-principal"
                            prefHeight="38"/>
                </HBox>
                <Region styleClass="filet-accent" prefHeight="3" maxWidth="56" minHeight="3"/>
            </VBox>

            <!-- Plutôt que de faire disparaître l'action sans explication, on
                 dit à l'Arbitre pourquoi elle ne lui est pas proposée. Une
                 fonction absente sans motif se lit comme un bug. -->
            <Label fx:id="noteRoleLecture"
                   styleClass="message-info"
                   wrapText="true"
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"/>

            <Label fx:id="messageErreur"
                   styleClass="message-erreur"
                   wrapText="true"
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"/>

            <TableView fx:id="tableTournois" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colonneNom"    text="TOURNOI"        prefWidth="340"/>
                    <TableColumn fx:id="colonneDate"   text="DATE DE DÉBUT"  prefWidth="170"/>
                    <TableColumn fx:id="colonneFormat" text="FORMAT"         prefWidth="210"/>
                    <TableColumn fx:id="colonneEtat"   text="ÉTAT"           prefWidth="190"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
